{
  "name": "marx-moltbook-growth-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A local, experiment-driven opportunity and messaging engine for Marx outreach on Moltbook.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "bin": {
    "marx-growth": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "config",
    "prompts",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:hermes": "node scripts/setup-hermes.mjs",
    "doctor:live": "node scripts/doctor-live.mjs",
    "live": "node scripts/live.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/main.ts",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "pino": "^9.6.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
